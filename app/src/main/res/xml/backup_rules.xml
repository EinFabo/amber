<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older read this instead of data_extraction_rules.xml. allowBackup="false"
  already turns backup off there; this says the same should a phone or a tool honour the rules
  file anyway: nothing of Amber's is backed up.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
