<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing of Amber's leaves the phone through Android's backup or device-to-device transfer:
  API keys (their encrypted file would arrive without its keystore key), settings with server
  addresses, statistics. allowBackup="false" only covers cloud backup below Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
