    <string name="inserting_capitals_note">Am Anfang eines Felds und nach . ! ?</string>
    <string name="inserting_punctuation">Satzzeichen anhängen</string>
    <string name="inserting_punctuation_note">„Hallo , Welt“ wird zu „Hallo, Welt“</string>
