<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window until the first frame, light or dark as the phone - or, from Android 12,
         as chosen in Amber (MainActivity.applyTheme). The screens are Compose's (AmberTheme). -->
    <style name="Theme.Amber" parent="android:Theme.Material.Light.NoActionBar">
        <!-- statusBarColor/navigationBarColor are ignored from targetSdk 35 (enforced
             edge-to-edge); the insets are handled by Scaffold and TopAppBar instead. -->
        <item name="android:windowBackground">@color/amber_background</item>
        <item name="android:colorAccent">@color/amber_primary</item>
    </style>

    <style name="Theme.Amber.Invisible" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

    <!-- The quick menu's "Style here" card: the app stays visible behind it, dimmed by the card itself. -->
    <style name="Theme.Amber.Sheet" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:colorAccent">#FFB020</item>
    </style>
</resources>
