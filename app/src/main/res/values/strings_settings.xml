    <string name="recording_auto_stop">Stop automatically on silence</string>
    <string name="recording_auto_stop_note">Off: it runs until the next tap.</string>
    <string name="recording_auto_stop_note_android">Off: it runs until the next tap - except with Android\'s speech recognition, which always stops at the first pause.</string>
    <string name="recording_text">Text</string>
    <string name="recording_text_more">Both work by rules, without a language model, so nothing is made up. The commas go before \"dass\", \"weil\", \"wenn\" or \"um ... zu\", where recognition often leaves them out - they never change a word.</string>
    <string name="recording_fillers">Remove filler words</string>
    <string name="recording_fillers_note">\"ähm\", \"äh\", \"um\" and the like</string>
    <string name="recording_commas">Add missing commas</string>
    <string name="recording_commas_note">German only</string>
    <string name="recording_while_speaking">Recognize while speaking</string>
    <string name="recording_while_speaking_more">Longer dictations are cut at pauses and recognized while you keep talking, so stopping only waits for the last part.</string>
    <string name="inserting_subtitle">How the text arrives at the cursor.</string>
    <string name="inserting_more">Off, text is only typed straight into the field and the clipboard stays untouched - a dictation that cannot be typed is reported. On, it is pasted instead, or copied as a last resort, and then shows up in the clipboard history.</string>
    <string name="inserting_spaces">Add spaces</string>
    <string name="inserting_spaces_note">Apart from the word before</string>
    <string name="inserting_capitals">Capitalize sentence starts</string>
    <string name="inserting_capitals_note">At the start of a field and after . ! ?</string>
    <string name="inserting_punctuation">Attach punctuation</string>
    <string name="inserting_punctuation_note">\"Hello , world\" becomes \"Hello, world\"</string>
    <string name="inserting_clipboard">Clipboard as a fallback</string>
    <string name="inserting_clipboard_note">When typing into the field fails</string>
